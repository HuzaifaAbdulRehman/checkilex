  },
  "dependencies": {
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
